@model IEnumerable<MEGATECH.Models.EF.Product>

<style>
    /* 1. Thiết lập lưới và khung card */
    .product-grid-container {
        display: flex;
        flex-wrap: wrap;
        margin: 0 -10px;
    }

    .product-item {
        padding: 10px;
        transition: all 0.3s ease;
    }

    .product_filter {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #f0f0f0;
        overflow: hidden;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .product_filter:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.08);
        border-color: transparent;
    }

    /* 2. Xử lý hình ảnh sản phẩm */
    .product_image {
        position: relative;
        width: 100%;
        height: 220px; /* Chiều cao cố định để các card bằng nhau */
        background-color: #f9f9f9;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        overflow: hidden;
    }

    .product_image img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain; /* Giúp chai nước không bị méo */
        transition: transform 0.5s ease;
    }

    .product_filter:hover .product_image img {
        transform: scale(1.08);
    }

    /* 3. Badge (NEW, SALE) - Kiểu hiện đại phẳng */
    .product_bubble {
        position: absolute;
        top: 12px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        color: #fff;
        z-index: 10;
        text-transform: uppercase;
    }

    .product_bubble_left {
        left: 12px;
        background: #28a745; /* Màu xanh lá cho hàng mới */
    }

    .product_bubble_right {
        right: 12px;
        background: #fe4c50; /* Màu đỏ cho giảm giá */
    }

    /* 4. Trái tim yêu thích */
    .favorite {
        position: absolute;
        top: 50px;
        right: 12px;
        width: 35px;
        height: 35px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        cursor: pointer;
        z-index: 5;
        transition: all 0.2s;
    }

    .favorite:hover {
        background: #fe4c50;
        color: #fff;
    }

    /* 5. Thông tin sản phẩm */
    .product_info {
        padding: 15px;
        text-align: left;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .product_name {
        margin-bottom: 8px;
        height: 42px; /* Giữ tiêu đề tối đa 2 dòng để card đều nhau */
        overflow: hidden;
    }

    .product_name a {
        font-size: 15px;
        font-weight: 600;
        color: #222;
        line-height: 1.4;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .product_price {
        font-size: 17px;
        font-weight: 700;
        color: #fe4c50;
        margin-top: auto;
    }

    .product_price span {
        font-size: 13px;
        color: #bbb;
        text-decoration: line-through;
        margin-left: 8px;
        font-weight: 400;
    }

    .stock_info {
        font-size: 12px;
        color: #888;
        margin-top: 5px;
    }

    /* 6. Nút Add to cart - Tách rời tinh tế */
    .add_to_cart_container {
        padding: 0 15px 15px 15px;
    }

    .btn_add_cart {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 40px;
        background: #1e1e27;
        color: #fff;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
    }

    .btn_add_cart:hover {
        background: #fe4c50;
        color: #fff;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(254, 76, 80, 0.3);
    }

    /* 7. Xử lý hết hàng */
    .out-of-stock-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 15;
    }

    .out-of-stock-label {
        background: rgba(0, 0, 0, 0.7);
        color: #fff;
        padding: 6px 15px;
        border-radius: 4px;
        font-weight: 600;
        font-size: 13px;
    }
</style>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <div class="col-lg-3 col-md-4 col-6 product-item @item.ProductCategory.Alias">
            <div class="product_filter">
                
                <div class="product_image">
                    <img src="@item.Image" alt="@item.Title">
                    
                    @if (item.SoLuong <= 0)
                    {
                        <div class="out-of-stock-overlay">
                            <div class="out-of-stock-label">Hết hàng</div>
                        </div>
                    }

                    @if (item.IsNew == true)
                    {
                        <div class="product_bubble product_bubble_left">New</div>
                    }
                    @if (item.GiamGia > 0)
                    {
                        <div class="product_bubble product_bubble_right">-@item.GiamGia%</div>
                    }
                </div>

                <div data-id="@item.MaSanPham" class="favorite">
                    <i class="fa fa-heart-o"></i>
                </div>

                <div class="product_info">
                    <h6 class="product_name">
                        <a href="/chi-tiet/@item.Alias-p@(item.MaSanPham)">@item.Title</a>
                    </h6>
                    <div class="product_price">
                        @MEGATECH.Common.Common.FormatNumber(item.GiaBan, 0)₫
                        @if (item.GiamGia > 0)
                        {
                            <span>@MEGATECH.Common.Common.FormatNumber(item.GiaNiemYet, 0)₫</span>
                        }
                    </div>
                    <div class="stock_info">Kho: @item.SoLuong</div>
                </div>

                <div class="add_to_cart_container">
                    @if (item.SoLuong > 0)
                    {
                        <a href="#" class="btn_add_cart btnAddToCart" data-id="@item.MaSanPham">
                            <i class="fa fa-shopping-cart" style="margin-right: 8px;"></i> Thêm vào giỏ
                        </a>
                    }
                    else
                    {
                        <a href="javascript:void(0)" class="btn_add_cart" style="background: #ccc; cursor: not-allowed;">
                            Liên hệ
                        </a>
                    }
                </div>

            </div>
        </div>
    }
}