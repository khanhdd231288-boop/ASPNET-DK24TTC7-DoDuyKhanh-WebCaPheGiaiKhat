@{
    ViewBag.Title = "MEGATECH - Thức uống giải khát hàng đầu";
    ViewBag.SeoDescription = "Chuyên cung cấp các loại nước giải khát, trà thảo mộc và cà phê chất lượng cao.";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    
    <link href="~/Content/assets/styles/bootstrap4/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/OwlCarousel2-2.2.1/owl.carousel.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/OwlCarousel2-2.2.1/owl.theme.default.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/OwlCarousel2-2.2.1/animate.css" rel="stylesheet" />
    
    <link rel="stylesheet" type="text/css" href="~/Content/assets/styles/main_styles.css">
    <link href="~/Content/assets/styles/responsive.css" rel="stylesheet" />

    <style>
        :root {
            --primary-color: #fe4c50;
            --dark-color: #1e1e27;
            --gray-light: #f5f5f7;
        }

        body { font-family: 'Roboto', sans-serif; background-color: #fff; color: #1e1e27; overflow-x: hidden; }

        /* 1. Banner & Carousel - Sửa lỗi cắt ảnh */
        #homeCarousel { background: #fff; }

        .carousel-item { 
            height: auto; 
            min-height: 400px; /* Chỉnh độ cao tối thiểu để banner cân đối */
            background: #fff; 
        }

        .carousel-item img { 
            width: 100%; 
            height: 100%; 
            object-fit: contain; /* Hiện toàn bộ ảnh, không bị mất góc */
            opacity: 1; 
        }
        
        /* Chỉnh lại Caption để không đè vào chai nước */
        .carousel-caption-custom {
            position: absolute;
            top: 50%;
            left: 6%; 
            transform: translateY(-50%);
            z-index: 10;
            color: #333; 
            text-align: left;
            max-width: 40%;
        }

        .carousel-caption-custom h1 {
            font-size: 3rem;
            font-weight: 900;
            text-transform: uppercase;
            line-height: 1.2;
            margin-bottom: 25px;
            text-shadow: 1px 1px 0px #fff; /* Đổ bóng trắng cho chữ trên nền ảnh */
        }

        /* Sửa nút Mua Ngay bị vỡ */
        .shop_now_button {
            display: inline-block;
            background: var(--primary-color);
            padding: 14px 35px;
            border-radius: 5px;
            color: #fff !important;
            font-weight: 700;
            text-transform: uppercase;
            text-decoration: none !important;
            transition: all 0.3s;
            min-width: 160px;
            text-align: center;
            border: none;
            box-shadow: 0 4px 10px rgba(254, 76, 80, 0.3);
        }

        .shop_now_button:hover {
            background: var(--dark-color);
            transform: scale(1.05);
            color: #fff !important;
        }

        /* 2. Section Styling */
        .section_container { padding: 80px 0; }
        .bg_light { background-color: var(--gray-light); }

        /* 3. Benefit Section */
        .benefit { padding: 60px 0; background: #fff; }
        .benefit_row {
            border: 1px solid #eee;
            border-radius: 12px;
            padding: 40px 10px;
            background: #fff;
            box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        }
        .benefit_col { border-right: 1px solid #eee; }
        .benefit_col:last-child { border-right: none; }
        .benefit_icon i { font-size: 32px; color: var(--primary-color); margin-right: 15px; }
        .benefit_content h6 { font-weight: 700; margin-bottom: 2px; text-transform: uppercase; font-size: 13px; }
        .benefit_content p { font-size: 12px; color: #777; margin: 0; }

        /* 4. Footer */
        .footer { background: var(--dark-color); color: #fff; padding: 80px 0 0; }
        .footer_title {
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 30px;
            position: relative;
            color: #fff;
        }
        .footer_title::after {
            content: "";
            position: absolute;
            left: 0; bottom: -10px;
            width: 30px; height: 2px;
            background: var(--primary-color);
        }
        .footer_list { list-style: none; padding: 0; }
        .footer_list li { margin-bottom: 15px; }
        .footer_list li a { color: #adadad; font-size: 14px; transition: 0.3s; }
        .footer_list li a:hover { color: var(--primary-color); padding-left: 5px; text-decoration: none; }
        
        .footer_social li { display: inline-block; margin-right: 20px; }
        .footer_social li a { color: #fff; font-size: 20px; transition: 0.3s; }
        .footer_social li a:hover { color: var(--primary-color); }

        .footer_bottom {
            margin-top: 60px;
            padding: 30px 0;
            border-top: 1px solid rgba(255,255,255,0.05);
            text-align: center;
            font-size: 13px;
            color: #777;
        }
        .footer_bottom a { color: var(--primary-color); font-weight: 500; }

        @@media (max-width: 991px) {
            .benefit_col { border-right: none; border-bottom: 1px solid #eee; padding: 20px; }
            .benefit_col:last-child { border-bottom: none; }
            .carousel-caption-custom h1 { font-size: 1.8rem; }
            .carousel-item { min-height: 250px; }
        }
    </style>
</head>
<body>

    <div class="super_container">
        
        <div id="homeCarousel" class="carousel slide carousel-fade" data-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="https://img.pikbest.com/templates/20240624/supermarket-store-bottled-fruit-beverage-banner_10635348.jpg!bw700" alt="Sảng khoái tức thì">
                    <div class="carousel-caption-custom">
                        <h1 class="animated fadeInDown">Sảng Khoái<br><span style="color:var(--primary-color)">Tức Thì</span></h1>
                        <a href="/san-pham" class="shop_now_button animated fadeInUp">Mua ngay</a>
                    </div>
                </div>
                
                <div class="carousel-item">
                    <img src="@Url.Content("~/Images/mot.jpg")" alt="Slide 2">
                    <div class="carousel-caption-custom">
                        <h1 class="animated fadeInDown" style="color:#fff">Năng Lượng<br>Tràn Đầy</h1>
                        <a href="/san-pham" class="shop_now_button animated fadeInUp">Xem thêm</a>
                    </div>
                </div>
            </div>
            
            <a class="carousel-control-prev" href="#homeCarousel" data-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </a>
            <a class="carousel-control-next" href="#homeCarousel" data-slide="next">
                <span class="carousel-control-next-icon"></span>
            </a>
        </div>

        <div class="section_container">
            <div class="container">
                @Html.Action("MenuProductCategory", "Menu")
            </div>
        </div>

        <div class="section_container bg_light">
            <div class="container">
                @Html.Action("MenuArrivals", "Menu")
            </div>
        </div>

        <div class="section_container">
            <div class="container">
                @Html.Action("Partial_ProductsHot", "Products")
            </div>
        </div>

        <div class="benefit">
            <div class="container">
                <div class="row benefit_row">
                    <div class="col-lg-3 col-md-6 benefit_col">
                        <div class="benefit_item d-flex align-items-center">
                            <div class="benefit_icon"><i class="fa fa-truck"></i></div>
                            <div class="benefit_content">
                                <h6>Giao hàng nhanh</h6>
                                <p>Nhận ngay trong 30p</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 benefit_col">
                        <div class="benefit_item d-flex align-items-center">
                            <div class="benefit_icon"><i class="fa fa-money"></i></div>
                            <div class="benefit_content">
                                <h6>Thanh toán COD</h6>
                                <p>An tâm nhận hàng</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 benefit_col">
                        <div class="benefit_item d-flex align-items-center">
                            <div class="benefit_icon"><i class="fa fa-undo"></i></div>
                            <div class="benefit_content">
                                <h6>Đổi trả dễ dàng</h6>
                                <p>Miễn phí 24h</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 benefit_col">
                        <div class="benefit_item d-flex align-items-center">
                            <div class="benefit_icon"><i class="fa fa-clock-o"></i></div>
                            <div class="benefit_content">
                                <h6>Hỗ trợ 24/7</h6>
                                <p>Phục vụ tận tâm</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 mb-5 mb-lg-0">
                        <h4 class="footer_title">Về Đỗ Duy Khánh</h4>
                        <p style="color: #888; font-size: 14px; line-height: 1.8;">
                            Sứ mệnh của chúng tôi là mang đến những thức uống tươi sạch, an toàn và đầy năng lượng cho cuộc sống bận rộn của bạn.
                        </p>
                        <ul class="footer_social">
                            <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                            <li><a href="#"><i class="fa fa-instagram"></i></a></li>
                            <li><a href="#"><i class="fa fa-youtube-play"></i></a></li>
                        </ul>
                    </div>
                    <div class="col-lg-4 mb-5 mb-lg-0 px-lg-5">
                        <h4 class="footer_title">Liên kết nhanh</h4>
                        <ul class="footer_list">
                            <li><a href="/">Trang chủ</a></li>
                            <li><a href="/san-pham">Sản phẩm</a></li>
                            <li><a href="/lien-he">Liên hệ</a></li>
                            <li><a href="/tin-tuc">Tin tức</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-4">
                        <h4 class="footer_title">Thông tin liên hệ</h4>
                        <ul class="footer_list">
                            <li><i class="fa fa-map-marker mr-2"></i> Trà Vinh</li>
                            <li><i class="fa fa-phone mr-2"></i> 0123 456 789</li>
                            <li><i class="fa fa-envelope mr-2"></i> doduykhanh.com</li>
                        </ul>
                    </div>
                </div>
                <div class="footer_bottom">
                </div>
            </div>
        </footer>

    </div>

    <script src="~/Content/assets/js/jquery-3.2.1.min.js"></script>
    <script src="~/Content/assets/styles/bootstrap4/popper.js"></script>
    <script src="~/Content/assets/styles/bootstrap4/bootstrap.min.js"></script>
</body>
</html>